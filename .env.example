# LifeOS Root Environment Configuration Template
# Copy this file to .env or create backend/.env and frontend/.env accordingly.

# ==============================================================================
# Backend Configuration
# ==============================================================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=lifeos_db
USE_MOCK_DB=false
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
COOKIE_SECURE=false
EMERGENT_LLM_KEY=your_emergent_or_claude_api_key
ADMIN_EMAIL=demo@lifeos.app
ADMIN_PASSWORD=lifeos123
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*
ENABLE_HEALTH_CHECK=true
FIREBASE_PROJECT_ID=lifeos-app-demo

# ==============================================================================
# Frontend Configuration
# ==============================================================================
NODE_ENV=development
REACT_APP_BACKEND_URL=http://localhost:8000

# Firebase Client SDK Configuration (Optional - Mocked in local preview mode)
REACT_APP_FIREBASE_API_KEY=AIzaSyDemoDummyApiKeyForLifeOSPreview123
REACT_APP_FIREBASE_AUTH_DOMAIN=lifeos-app-demo.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=lifeos-app-demo
REACT_APP_FIREBASE_STORAGE_BUCKET=lifeos-app-demo.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
